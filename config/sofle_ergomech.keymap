#include <dt-bindings/zmk/pointing.h>
#include <behaviors.dtsi>
#include <behaviors/mouse_keypad.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/rgb.h>

#define DEFAULT     0
#define FN          1
#define QWERTY      2
#define AZERTY      3
#define AZERTY_MAJ  4
#define STAND_BY_1  5
#define STAND_BY_2  6
#define STAND_BY_3  7

/ {
	// Activate ADJUST layer by pressing raise and lower


	behaviors {
		mousescroll: mousescroll {
			compatible = "zmk,behavior-sensor-rotate";
			#sensor-binding-cells = <0>;
			bindings = <&msc SCRL_DOWN>, <&msc SCRL_UP>;
			tap-ms = <20>;
		};
		
		shift: hold_tap_shift {
			compatible = "zmk,behavior-hold-tap";
			#binding-cells = <2>;
			flavor = "hold-preferred";
			tapping-term-ms = <200>;
			bindings = <&kp>, <&kp>;
		};
		
		ht_l: hold_tap_layer {
			compatible = "zmk,behavior-hold-tap";
			#binding-cells = <2>;
			flavor = "hold-preferred";
			tapping-term-ms = <200>;
			bindings = <&mo>, <&to>;
		};
		
		td_q: td_q {
			compatible = "zmk,behavior-tap-dance";
			#binding-cells = <0>;
			tapping-term-ms = <200>;
			bindings = <&kp M>, <&kp BSLH>;
		};
		
		am_right: am_right {
			compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&mkp MOVE_RIGHT>, <&msc SCRL_RIGHT>;
            mods = <MOD_LALT>;
		};
		
		am_up: am_up {
			compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&mkp MOVE_UP>, <&msc SCRL_UP>;
            mods = <MOD_LALT>;
		};
		
		am_left: am_left {
			compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&mkp MOVE_LEFT>, <&msc SCRL_LEFT>;
            mods = <MOD_LALT>;
		};
		
		am_down: am_down {
			compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&mkp MOVE_DOWN>, <&msc SCRL_DOWN>;
            mods = <MOD_LALT>;
		};
	};

    keymap {
		compatible = "zmk,keymap";
		
		default_layer {
			label = "Base";
// ── DEFAULT ─────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────
			bindings = <
// ╭────────────────┬────────────────┬────────────────┬────────────────┬────────────────┬────────────────╮                                      ╭────────────────┬────────────────┬────────────────┬────────────────┬────────────────┬────────────────╮
// │ $              │ "              │ «              │ »              │ (              │ )              │                                      │ @              │ +              │ -              │ /              │ *              │ =              │
     &kp GRAVE        &kp N1           &kp N2           &kp N3           &kp N4           &kp N5                                                  &kp N6           &kp N7           &kp N8            &kp N9          &kp N0           &kp MINUS
// ├────────────────┼────────────────┼────────────────┼────────────────┼────────────────┼────────────────┤                                      ├────────────────┼────────────────┼────────────────┼────────────────┼────────────────┼────────────────┤
// │ TAB            │ b              │ é              │ p              │ o              │ è              │                                      │ ^              │ v              │ d              │ l              │ j              │ w              │
     &kp TAB          &kp Q            &kp W            &kp E            &kp R            &kp T                                                   &kp Y            &kp U            &kp I            &kp O            &kp P            &kp RBKT
// ├────────────────┼────────────────┼────────────────┼────────────────┼────────────────┼────────────────┤                                      ├────────────────┼────────────────┼────────────────┼────────────────┼────────────────┼────────────────┤
// │ MAJ            │ a              │ u              │ i              │ e              │ ,              │                                      │ c              │ t              │ s              │ r              │ n              │ m              │
     &shift LSHFT CLCK &kp A          &kp S            &kp D            &kp F            &kp G                                                   &kp H            &kp J            &kp K            &kp L            &kp SEMI         &kp SQT
// ├────────────────┼────────────────┼────────────────┼────────────────┼────────────────┼────────────────┤                                      ├────────────────┼────────────────┼────────────────┼────────────────┼────────────────┼────────────────┤
// │ CTRL           │ à              │ y              │ x              │ .              │ k              │                                      │ '              │ q/ç            │ g              │ h              │ f              │ z              │
     &kp LCTRL        &kp Z            &kp X            &kp C            &kp V            &kp B                                                   &kp N            &td_q            &kp COMMA        &kp DOT          &kp FSLH         &kp LBKT
// ╰────────────────┴────────────────┼────────────────┼────────────────┼────────────────┼────────────────┼────────────────╮    ╭────────────────┼────────────────┼────────────────┼────────────────┼────────────────┼────────────────┼────────────────╯
//                                   │ <FN>           │ WIN            │ ALT            │ SPACE          │ ESC            │    │ BKSPC          │ ENTER          │ ALTGR          │ HOME           │ END            │
     &mkp MB1                          &ht_l FN FN      &kp LGUI         &kp LALT         &kp SPACE        &kp ESC               &kp BSPC         &mo RET          &kp RALT         &kp HOME         &kp END
//                                   ╰────────────────┴────────────────┴────────────────┴────────────────┴────────────────╯    ╰────────────────┴────────────────┴────────────────┴────────────────┴────────────────╯
&mkp MB2 &kp RIGHT &kp UP &kp LEFT &kp DOWN
			>;
			sensor-bindings = <&mousescroll &mousescroll>;
		};
		
		fn_layer {
			label = "Function";
// ── FN ──────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────
			bindings = <
// ╭────────────────┬────────────────┬────────────────┬────────────────┬────────────────┬────────────────╮                                      ╭────────────────┬────────────────┬────────────────┬────────────────┬────────────────┬────────────────╮
// │ F1             │ F2             │ F3             │ F4             │ F5             │ F6             │                                      │ F7             │ F8             │ F9             │ F10            │ F11            │ F12            │
     &kp F1           &kp F2           &kp F3           &kp F4           &kp F5           &kp F6                                                  &kp F7           &kp F8           &kp F9           &kp F10          &kp F11          &kp F12
// ├────────────────┼────────────────┼────────────────┼────────────────┼────────────────┼────────────────┤                                      ├────────────────┼────────────────┼────────────────┼────────────────┼────────────────┼────────────────┤
// │ studio         │ QWERTY         │ AZERTY         │                │                │                │                                      │ MUTE           │ %              │ 7              │ 8              │ 9              │ =              │
     &studio_unlock   &mo QWERTY       &mo AZERTY       &none            &none            &none                                                   &kp C_MUTE       &kp N5           &kp LS(N7)       &kp LS(N8)       &kp LS(N9)       &kp KP_EQUAL
// ├────────────────┼────────────────┼────────────────┼────────────────┼────────────────┼────────────────┤                                      ├────────────────┼────────────────┼────────────────┼────────────────┼────────────────┼────────────────┤
// │ studio         │                │                │                │                │                │                                      │ Vol+           │ *              │ 4              │ 5              │ 6              │ +              │
     &studio_unlock   &none            &none            &none            &none            &none                                                   &kp C_VOL_UP     &kp KP_MULTIPLY  &kp LS(N4)       &kp LS(N5)       &kp LS(N6)       &kp KP_PLUS
// ├────────────────┼────────────────┼────────────────┼────────────────┼────────────────┼────────────────┤                                      ├────────────────┼────────────────┼────────────────┼────────────────┼────────────────┼────────────────┤
// │ BLUETOOTH      │                │ CUT            │ COPY           │ PASTE          │                │                                      │ Vol-           │ /              │ 1              │ 2              │ 3              │ -              │
     &bt BT_CLR       &none            &kp C_AC_CUT     &kp C_AC_COPY    &kp C_AC_PASTE   &none                                                   &kp C_VOL_DN     &kp KP_SLASH     &kp LS(N1)       &kp LS(N2)       &kp LS(N3)       &kp KP_MINUS
// ╰────────────────┴────────────────┼────────────────┼────────────────┼────────────────┼────────────────┼────────────────╮    ╭────────────────┼────────────────┼────────────────┼────────────────┼────────────────┼────────────────┼────────────────╯
//                                   │ <FN>           │ WIN            │ ALT            │ SPACE          │ ESC            │    │ BKSPC          │ ENTER          │ ALTGR          │ 0              │ .              │
     &kp C_MUTE                        &to DEFAULT      &trans           &trans           &trans           &trans                &trans           &trans           &trans           &kp LS(N0)       &kp DOT
//                                   ╰────────────────┴────────────────┴────────────────┴────────────────┴────────────────╯    ╰────────────────┴────────────────┴────────────────┴────────────────┴────────────────╯
&mkp MB2 &mkp MOVE_RIGHT &mkp MOVE_UP &mkp MOVE_LEFT &mkp MOVE_DOWN
			>;
			sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
		};
		
		qwerty_layer {
			label = "QWERTY";
// ── QWERTY ──────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────
			bindings = <
// ╭────────────────┬────────────────┬────────────────┬────────────────┬────────────────┬────────────────╮                                      ╭────────────────┬────────────────┬────────────────┬────────────────┬────────────────┬────────────────╮
// │                │                │                │                │                │                │                                      │                │                │                │                │                │                │
     &trans           &trans           &trans           &trans           &trans           &trans                                                  &trans           &trans           &trans           &trans           &trans           &trans
// ├────────────────┼────────────────┼────────────────┼────────────────┼────────────────┼────────────────┤                                      ├────────────────┼────────────────┼────────────────┼────────────────┼────────────────┼────────────────┤
// │                │                │                │                │                │                │                                      │                │                │                │                │                │                │
     &trans           &trans           &trans           &trans           &trans           &trans                                                  &trans           &trans           &trans           &trans           &trans           &trans
// ├────────────────┼────────────────┼────────────────┼────────────────┼────────────────┼────────────────┤                                      ├────────────────┼────────────────┼────────────────┼────────────────┼────────────────┼────────────────┤
// │                │                │                │                │                │                │                                      │                │                │                │                │                │                │
     &trans           &trans           &trans           &trans           &trans           &trans                                                  &trans           &trans           &trans           &trans           &trans           &trans
// ├────────────────┼────────────────┼────────────────┼────────────────┼────────────────┼────────────────┤                                      ├────────────────┼────────────────┼────────────────┼────────────────┼────────────────┼────────────────┤
// │                │                │                │                │                │                │                                      │                │                │                │                │                │                │
     &trans           &trans           &trans           &trans           &trans           &trans                                                  &trans           &trans           &trans           &trans           &trans           &trans
// ╰────────────────┴────────────────┼────────────────┼────────────────┼────────────────┼────────────────┼────────────────╮    ╭────────────────┼────────────────┼────────────────┼────────────────┼────────────────┼────────────────┼────────────────╯
//                                   │                │                │                │                │                │    │                │                │                │                │                │
     &trans                            &trans           &trans           &trans           &trans           &trans                &trans           &trans           &trans           &trans           &trans
//                                   ╰────────────────┴────────────────┴────────────────┴────────────────┴────────────────╯    ╰────────────────┴────────────────┴────────────────┴────────────────┴────────────────╯
&trans &trans &trans &trans &trans
			>;
			sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
		};
		
		azerty_layer {
			label = "AZERTY";
// ── AZERTY ──────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────
			bindings = <
// ╭────────────────┬────────────────┬────────────────┬────────────────┬────────────────┬────────────────╮                                      ╭────────────────┬────────────────┬────────────────┬────────────────┬────────────────┬────────────────╮
// │                │                │                │                │                │                │                                      │                │                │                │                │                │                │
     &trans           &trans           &trans           &trans           &trans           &trans                                                  &trans           &trans           &trans           &trans           &trans           &trans
// ├────────────────┼────────────────┼────────────────┼────────────────┼────────────────┼────────────────┤                                      ├────────────────┼────────────────┼────────────────┼────────────────┼────────────────┼────────────────┤
// │                │                │                │                │                │                │                                      │                │                │                │                │                │                │
     &trans           &trans           &trans           &trans           &trans           &trans                                                  &trans           &trans           &trans           &trans           &trans           &trans
// ├────────────────┼────────────────┼────────────────┼────────────────┼────────────────┼────────────────┤                                      ├────────────────┼────────────────┼────────────────┼────────────────┼────────────────┼────────────────┤
// │                │                │                │                │                │                │                                      │                │                │                │                │                │                │
     &trans           &trans           &trans           &trans           &trans           &trans                                                  &trans           &trans           &trans           &trans           &trans           &trans
// ├────────────────┼────────────────┼────────────────┼────────────────┼────────────────┼────────────────┤                                      ├────────────────┼────────────────┼────────────────┼────────────────┼────────────────┼────────────────┤
// │                │                │                │                │                │                │                                      │                │                │                │                │                │                │
     &trans           &trans           &trans           &trans           &trans           &trans                                                  &trans           &trans           &trans           &trans           &trans           &trans
// ╰────────────────┴────────────────┼────────────────┼────────────────┼────────────────┼────────────────┼────────────────╮    ╭────────────────┼────────────────┼────────────────┼────────────────┼────────────────┼────────────────┼────────────────╯
//                                   │                │                │                │                │                │    │                │                │                │                │                │
     &trans                            &trans           &trans           &trans           &trans           &trans                &trans           &trans           &trans           &trans           &trans
//                                   ╰────────────────┴────────────────┴────────────────┴────────────────┴────────────────╯    ╰────────────────┴────────────────┴────────────────┴────────────────┴────────────────╯
&trans &trans &trans &trans &trans
			>;
			sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
		};
		
		azertymaj_layer {
			label = "AZERTY MAJ";
// ── AZERTY ──────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────
			bindings = <
// ╭────────────────┬────────────────┬────────────────┬────────────────┬────────────────┬────────────────╮                                      ╭────────────────┬────────────────┬────────────────┬────────────────┬────────────────┬────────────────╮
// │                │                │                │                │                │                │                                      │                │                │                │                │                │                │
     &trans           &trans           &trans           &trans           &trans           &trans                                                  &trans           &trans           &trans           &trans           &trans           &trans
// ├────────────────┼────────────────┼────────────────┼────────────────┼────────────────┼────────────────┤                                      ├────────────────┼────────────────┼────────────────┼────────────────┼────────────────┼────────────────┤
// │                │                │                │                │                │                │                                      │                │                │                │                │                │                │
     &trans           &trans           &trans           &trans           &trans           &trans                                                  &trans           &trans           &trans           &trans           &trans           &trans
// ├────────────────┼────────────────┼────────────────┼────────────────┼────────────────┼────────────────┤                                      ├────────────────┼────────────────┼────────────────┼────────────────┼────────────────┼────────────────┤
// │                │                │                │                │                │                │                                      │                │                │                │                │                │                │
     &trans           &trans           &trans           &trans           &trans           &trans                                                  &trans           &trans           &trans           &trans           &trans           &trans
// ├────────────────┼────────────────┼────────────────┼────────────────┼────────────────┼────────────────┤                                      ├────────────────┼────────────────┼────────────────┼────────────────┼────────────────┼────────────────┤
// │                │                │                │                │                │                │                                      │                │                │                │                │                │                │
     &trans           &trans           &trans           &trans           &trans           &trans                                                  &trans           &trans           &trans           &trans           &trans           &trans
// ╰────────────────┴────────────────┼────────────────┼────────────────┼────────────────┼────────────────┼────────────────╮    ╭────────────────┼────────────────┼────────────────┼────────────────┼────────────────┼────────────────┼────────────────╯
//                                   │                │                │                │                │                │    │                │                │                │                │                │
     &trans                            &trans           &trans           &trans           &trans           &trans                &trans           &trans           &trans           &trans           &trans
//                                   ╰────────────────┴────────────────┴────────────────┴────────────────┴────────────────╯    ╰────────────────┴────────────────┴────────────────┴────────────────┴────────────────╯
&trans &trans &trans &trans &trans
			>;
			sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
		};
		
		standby1_layer {
			label = "L1";
// ── AZERTY ──────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────
			bindings = <
// ╭────────────────┬────────────────┬────────────────┬────────────────┬────────────────┬────────────────╮                                      ╭────────────────┬────────────────┬────────────────┬────────────────┬────────────────┬────────────────╮
// │                │                │                │                │                │                │                                      │                │                │                │                │                │                │
     &trans           &trans           &trans           &trans           &trans           &trans                                                  &trans           &trans           &trans           &trans           &trans           &trans
// ├────────────────┼────────────────┼────────────────┼────────────────┼────────────────┼────────────────┤                                      ├────────────────┼────────────────┼────────────────┼────────────────┼────────────────┼────────────────┤
// │                │                │                │                │                │                │                                      │                │                │                │                │                │                │
     &trans           &trans           &trans           &trans           &trans           &trans                                                  &trans           &trans           &trans           &trans           &trans           &trans
// ├────────────────┼────────────────┼────────────────┼────────────────┼────────────────┼────────────────┤                                      ├────────────────┼────────────────┼────────────────┼────────────────┼────────────────┼────────────────┤
// │                │                │                │                │                │                │                                      │                │                │                │                │                │                │
     &trans           &trans           &trans           &trans           &trans           &trans                                                  &trans           &trans           &trans           &trans           &trans           &trans
// ├────────────────┼────────────────┼────────────────┼────────────────┼────────────────┼────────────────┤                                      ├────────────────┼────────────────┼────────────────┼────────────────┼────────────────┼────────────────┤
// │                │                │                │                │                │                │                                      │                │                │                │                │                │                │
     &trans           &trans           &trans           &trans           &trans           &trans                                                  &trans           &trans           &trans           &trans           &trans           &trans
// ╰────────────────┴────────────────┼────────────────┼────────────────┼────────────────┼────────────────┼────────────────╮    ╭────────────────┼────────────────┼────────────────┼────────────────┼────────────────┼────────────────┼────────────────╯
//                                   │                │                │                │                │                │    │                │                │                │                │                │
     &trans                            &trans           &trans           &trans           &trans           &trans                &trans           &trans           &trans           &trans           &trans
//                                   ╰────────────────┴────────────────┴────────────────┴────────────────┴────────────────╯    ╰────────────────┴────────────────┴────────────────┴────────────────┴────────────────╯
&trans &trans &trans &trans &trans
			>;
			sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
		};
		
		standby2_layer {
			label = "L2";
// ── AZERTY ──────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────
			bindings = <
// ╭────────────────┬────────────────┬────────────────┬────────────────┬────────────────┬────────────────╮                                      ╭────────────────┬────────────────┬────────────────┬────────────────┬────────────────┬────────────────╮
// │                │                │                │                │                │                │                                      │                │                │                │                │                │                │
     &trans           &trans           &trans           &trans           &trans           &trans                                                  &trans           &trans           &trans           &trans           &trans           &trans
// ├────────────────┼────────────────┼────────────────┼────────────────┼────────────────┼────────────────┤                                      ├────────────────┼────────────────┼────────────────┼────────────────┼────────────────┼────────────────┤
// │                │                │                │                │                │                │                                      │                │                │                │                │                │                │
     &trans           &trans           &trans           &trans           &trans           &trans                                                  &trans           &trans           &trans           &trans           &trans           &trans
// ├────────────────┼────────────────┼────────────────┼────────────────┼────────────────┼────────────────┤                                      ├────────────────┼────────────────┼────────────────┼────────────────┼────────────────┼────────────────┤
// │                │                │                │                │                │                │                                      │                │                │                │                │                │                │
     &trans           &trans           &trans           &trans           &trans           &trans                                                  &trans           &trans           &trans           &trans           &trans           &trans
// ├────────────────┼────────────────┼────────────────┼────────────────┼────────────────┼────────────────┤                                      ├────────────────┼────────────────┼────────────────┼────────────────┼────────────────┼────────────────┤
// │                │                │                │                │                │                │                                      │                │                │                │                │                │                │
     &trans           &trans           &trans           &trans           &trans           &trans                                                  &trans           &trans           &trans           &trans           &trans           &trans
// ╰────────────────┴────────────────┼────────────────┼────────────────┼────────────────┼────────────────┼────────────────╮    ╭────────────────┼────────────────┼────────────────┼────────────────┼────────────────┼────────────────┼────────────────╯
//                                   │                │                │                │                │                │    │                │                │                │                │                │
     &trans                            &trans           &trans           &trans           &trans           &trans                &trans           &trans           &trans           &trans           &trans
//                                   ╰────────────────┴────────────────┴────────────────┴────────────────┴────────────────╯    ╰────────────────┴────────────────┴────────────────┴────────────────┴────────────────╯
&trans &trans &trans &trans &trans
			>;
			sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
		};
		
		standby3_layer {
			label = "L3";
// ── AZERTY ──────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────
			bindings = <
// ╭────────────────┬────────────────┬────────────────┬────────────────┬────────────────┬────────────────╮                                      ╭────────────────┬────────────────┬────────────────┬────────────────┬────────────────┬────────────────╮
// │                │                │                │                │                │                │                                      │                │                │                │                │                │                │
     &trans           &trans           &trans           &trans           &trans           &trans                                                  &trans           &trans           &trans           &trans           &trans           &trans
// ├────────────────┼────────────────┼────────────────┼────────────────┼────────────────┼────────────────┤                                      ├────────────────┼────────────────┼────────────────┼────────────────┼────────────────┼────────────────┤
// │                │                │                │                │                │                │                                      │                │                │                │                │                │                │
     &trans           &trans           &trans           &trans           &trans           &trans                                                  &trans           &trans           &trans           &trans           &trans           &trans
// ├────────────────┼────────────────┼────────────────┼────────────────┼────────────────┼────────────────┤                                      ├────────────────┼────────────────┼────────────────┼────────────────┼────────────────┼────────────────┤
// │                │                │                │                │                │                │                                      │                │                │                │                │                │                │
     &trans           &trans           &trans           &trans           &trans           &trans                                                  &trans           &trans           &trans           &trans           &trans           &trans
// ├────────────────┼────────────────┼────────────────┼────────────────┼────────────────┼────────────────┤                                      ├────────────────┼────────────────┼────────────────┼────────────────┼────────────────┼────────────────┤
// │                │                │                │                │                │                │                                      │                │                │                │                │                │                │
     &trans           &trans           &trans           &trans           &trans           &trans                                                  &trans           &trans           &trans           &trans           &trans           &trans
// ╰────────────────┴────────────────┼────────────────┼────────────────┼────────────────┼────────────────┼────────────────╮    ╭────────────────┼────────────────┼────────────────┼────────────────┼────────────────┼────────────────┼────────────────╯
//                                   │                │                │                │                │                │    │                │                │                │                │                │
     &trans                            &trans           &trans           &trans           &trans           &trans                &trans           &trans           &trans           &trans           &trans
//                                   ╰────────────────┴────────────────┴────────────────┴────────────────┴────────────────╯    ╰────────────────┴────────────────┴────────────────┴────────────────┴────────────────╯
&trans &trans &trans &trans &trans
			>;
			sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
		};
	};
};
