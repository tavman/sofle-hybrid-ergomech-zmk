#include <dt-bindings/zmk/pointing.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/rgb.h>

#define DEFAULT    0
#define FN         1
#define QWERTY     2
#define AZERTY     3
#define AZERTY_MAJ 4
#define STAND_BY_1 5
#define STAND_BY_2 6
#define STAND_BY_3 7

/ {
    // Activate ADJUST layer by pressing raise and lower


	behaviors {
        mousescroll: mousescroll {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_DOWN>, <&msc SCRL_UP>;
			tap-ms = <20>;
        };

        ht: sh_ht {
			compatible = "zmk,behavior-hold-tap";
			#binding-cells = <2>;
			flavor = "hold-preferred";
			tapping-term-ms = <200>;
			bindings = <&kp>, <&kt>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            label = "Base";
			// -- DEFAULT ------------------------------------------------------------------------------------
			bindings = <
// ╭────────────────┬────────────────┬────────────────┬────────────────┬────────────────┬────────────────╮                                      ╭────────────────┬────────────────┬────────────────┬────────────────┬────────────────┬────────────────╮
// │ $              │ "              │ «              │ »              │ (              │ )              │                                      │ @              │ +              │ -              │ /              │ *              │ =              │
     &kp GRAVE        &kp N1           &kp N2           &kp N3           &kp N4           &kp N5                                                  &kp N6           &kp N7           &kp N8            &kp N9          &kp N0           &kp MINUS
// ├────────────────┼────────────────┼────────────────┼────────────────┼────────────────┼────────────────┤                                      ├────────────────┼────────────────┼────────────────┼────────────────┼────────────────┼────────────────┤
// │ TAB            │ b              │ é              │ p              │ o              │ è              │                                      │ ^              │ v              │ d              │ l              │ j              │ w              │
     &kp TAB          &kp Q            &kp W            &kp E            &kp R            &kp T                                                   &kp Y            &kp U            &kp I            &kp O            &kp P            &kp RBKT
// ├────────────────┼────────────────┼────────────────┼────────────────┼────────────────┼────────────────┤                                      ├────────────────┼────────────────┼────────────────┼────────────────┼────────────────┼────────────────┤
// │ MAJ            │ a              │ u              │ i              │ e              │ ,              │                                      │ c              │ t              │ s              │ r              │ n              │ m              │
     &ht LSHFT LSHFT  &kp A            &kp S            &kp D            &kp F            &kp G                                                   &kp H            &kp J            &kp K            &kp L            &kp SEMI         &kp SQT
// ├────────────────┼────────────────┼────────────────┼────────────────┼────────────────┼────────────────┤                                      ├────────────────┼────────────────┼────────────────┼────────────────┼────────────────┼────────────────┤
// │ CTRL           │ à              │ y              │ x              │ .              │ k              │                                      │ '              │ q              │ g              │ h              │ f              │ z              │
     &kp LCTRL        &kp Z            &kp X            &kp C            &kp V            &kp B                                                   &kp N            &kp M            &kp COMMA        &kp DOT          &kp FSLH         &kp LBKT
// ╰────────────────┴────────────────┼────────────────┼────────────────┼────────────────┼────────────────┼────────────────╮    ╭────────────────┼────────────────┼────────────────┼────────────────┼────────────────┼────────────────┼────────────────╯
//                                   │ <FN>           │ WIN            │ ALT            │ SPACE          │ ESC            │    │ BKSPC          │ ENTER          │ ALTGR          │ HOME           │ END            │
     &kp C_MUTE                        &ht FN FN        &kp LGUI         &kp LALT         &kp SPACE        &kp ESC               &kp BSPC         &mo RET          &kp RALT         &kp HOME         &kp END
//                                   ╰────────────────┴────────────────┴────────────────┴────────────────┴────────────────╯    ╰────────────────┴────────────────┴────────────────┴────────────────┴────────────────╯

&mkp LCLK  &kp RIGHT  &kp UP     &kp LEFT  &kp DOWN
            >;

            // sensor-bindings = <&mousescroll &inc_dec_kp PG_UP PG_DN>;
            sensor-bindings = <&mousescroll &mousescroll>;
            // sensor-bindings = <&msc SCRL_UP SCRL_DOWN &msc SCRL_UP SCRL_DOWN>;
        };

        fn_layer {
            label = "Function";

            // -- FN -------------------------------------------------------++++----------------------------------------
            // | F1     | F2     | F3     | F4   | F5    | F6    |     ||||       | F7    | F8    | F9 | F10 | F11 | F12 |
            // | studio | QWERTY | AZERTY |      |       |       |     ||||       | MUTE  | %     | 7  | 8   | 9   | =   |
            // | studio |        |        |      |       |       |     ||||       | Vol+  | *     | 4  | 5   | 6   | +   |
            // | studio |        | CUT    | COPY | PASTE |       |     ||||       | Vol-  | /     | 1  | 2   | 3   | -   |
            //                   | **     | WIN  | ALT   | SPACE | ESC |||| BKSPC | ENTER | ALTGR | 0  | .   |

            bindings = <
&kp F1          &kp F2       &kp F3       &kp F4      &kp F5       &kp F6                  &kp F7        &kp F8           &kp F9     &kp F10    &kp F11     &kp F12
&studio_unlock  &mo QWERTY   &mo AZERTY   &none       &none        &none                   &kp C_MUTE    &kp PERCENT      &kp KP_N7  &kp KP_N8  &kp KP_N9   &kp KP_EQUAL
&studio_unlock  &none        &none        &none       &none        &none                   &kp C_VOL_UP  &kp KP_MULTIPLY  &kp KP_N4  &kp KP_N5  &kp KP_N6   &kp KP_PLUS
&studio_unlock  &none        &kp K_CUT    &kp K_COPY  &kp K_PASTE  &none                   &kp C_VOL_DN  &kp KP_SLASH     &kp KP_N1  &kp KP_N2  &kp KP_N3   &kp KP_MINUS
&kp C_MUTE                   &mo DEFAULT  &trans      &trans       &trans  &trans  &trans  &trans        &trans           &kp N0     &kp KP_DOT

&mkp LCLK  &kp RIGHT  &kp UP     &kp LEFT  &kp DOWN
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        qwerty_layer {
            label = "QWERTY";

            // ------------------------------------------------------------------------------------------------------------
            // | BTCLR | BT1  | BT2  |  BT3  |  BT4  |  BT5 |                |      |      |       |      |       |       |
            // |       | INS  | PSCR | GUI   |       |      |                | PGUP |      |   ^   |      |       |       |
            // |       | ALT  | CTRL | SHIFT |       | CAPS |                | PGDN |   <- |   v   |  ->  |  DEL  | BKSPC |
            // |       | UNDO | CUT  | COPY  | PASTE |      |      |  |      |      |      |       |      |       |       |
            //                |      |       |       |      |      |  |      |      |      |       |      |

            bindings = <
&trans &trans &trans &trans &trans &trans               &trans &trans &trans &trans &trans &trans
&trans &trans &trans &trans &trans &trans               &trans &trans &trans &trans &trans &trans
&trans &trans &trans &trans &trans &trans               &trans &trans &trans &trans &trans &trans
&trans &trans &trans &trans &trans &trans               &trans &trans &trans &trans &trans &trans
&trans        &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans

&trans &trans &trans &trans &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        azerty_layer {
            label = "AZERTY";
			
            // ----------------------------------------------------------------------------------------------------------------------------
            // | BTCLR  |  BT1    |  BT2    |   BT3   |   BT4   |   BT5   |                  |      |      |       |      |       |       |
            // | EXTPWR | RGB_HUD | RGB_HUI | RGB_SAD | RGB_SAI | RGB_EFF |                  |      |      |       |      |       |       |
            // |        | RGB_BRD | RGB_BRI |         |         |         |                  |      |      |       |      |       |       |
            // |        |         |         |         |         |         | RGB_TOG | |      |      |      |       |      |       |       |
            //                    |         |         |         |         |         | |      |      |      |       |      |

            bindings = <
&trans &trans &trans &trans &trans &trans               &trans &trans &trans &trans &trans &trans
&trans &trans &trans &trans &trans &trans               &trans &trans &trans &trans &trans &trans
&trans &trans &trans &trans &trans &trans               &trans &trans &trans &trans &trans &trans
&trans &trans &trans &trans &trans &trans               &trans &trans &trans &trans &trans &trans
&trans        &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans

&trans &trans &trans &trans &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        azertymaj_layer {
            label = "AZERTY MAJ";
			
            // ----------------------------------------------------------------------------------------------------------------------------
            // | BTCLR  |  BT1    |  BT2    |   BT3   |   BT4   |   BT5   |                  |      |      |       |      |       |       |
            // | EXTPWR | RGB_HUD | RGB_HUI | RGB_SAD | RGB_SAI | RGB_EFF |                  |      |      |       |      |       |       |
            // |        | RGB_BRD | RGB_BRI |         |         |         |                  |      |      |       |      |       |       |
            // |        |         |         |         |         |         | RGB_TOG | |      |      |      |       |      |       |       |
            //                    |         |         |         |         |         | |      |      |      |       |      |

            bindings = <
&trans &trans &trans &trans &trans &trans               &trans &trans &trans &trans &trans &trans
&trans &trans &trans &trans &trans &trans               &trans &trans &trans &trans &trans &trans
&trans &trans &trans &trans &trans &trans               &trans &trans &trans &trans &trans &trans
&trans &trans &trans &trans &trans &trans               &trans &trans &trans &trans &trans &trans
&trans        &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans

&trans &trans &trans &trans &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        standby1_layer {
            label = "L1";
			
            // ----------------------------------------------------------------------------------------------------------------------------
            // | BTCLR  |  BT1    |  BT2    |   BT3   |   BT4   |   BT5   |                  |      |      |       |      |       |       |
            // | EXTPWR | RGB_HUD | RGB_HUI | RGB_SAD | RGB_SAI | RGB_EFF |                  |      |      |       |      |       |       |
            // |        | RGB_BRD | RGB_BRI |         |         |         |                  |      |      |       |      |       |       |
            // |        |         |         |         |         |         | RGB_TOG | |      |      |      |       |      |       |       |
            //                    |         |         |         |         |         | |      |      |      |       |      |

            bindings = <
&trans &trans &trans &trans &trans &trans               &trans &trans &trans &trans &trans &trans
&trans &trans &trans &trans &trans &trans               &trans &trans &trans &trans &trans &trans
&trans &trans &trans &trans &trans &trans               &trans &trans &trans &trans &trans &trans
&trans &trans &trans &trans &trans &trans               &trans &trans &trans &trans &trans &trans
&trans        &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans

&trans &trans &trans &trans &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        standby2_layer {
            label = "L2";
			
            // ----------------------------------------------------------------------------------------------------------------------------
            // | BTCLR  |  BT1    |  BT2    |   BT3   |   BT4   |   BT5   |                  |      |      |       |      |       |       |
            // | EXTPWR | RGB_HUD | RGB_HUI | RGB_SAD | RGB_SAI | RGB_EFF |                  |      |      |       |      |       |       |
            // |        | RGB_BRD | RGB_BRI |         |         |         |                  |      |      |       |      |       |       |
            // |        |         |         |         |         |         | RGB_TOG | |      |      |      |       |      |       |       |
            //                    |         |         |         |         |         | |      |      |      |       |      |

            bindings = <
&trans &trans &trans &trans &trans &trans               &trans &trans &trans &trans &trans &trans
&trans &trans &trans &trans &trans &trans               &trans &trans &trans &trans &trans &trans
&trans &trans &trans &trans &trans &trans               &trans &trans &trans &trans &trans &trans
&trans &trans &trans &trans &trans &trans               &trans &trans &trans &trans &trans &trans
&trans        &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans

&trans &trans &trans &trans &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        standby3_layer {
            label = "L3";
			
            // ----------------------------------------------------------------------------------------------------------------------------
            // | BTCLR  |  BT1    |  BT2    |   BT3   |   BT4   |   BT5   |                  |      |      |       |      |       |       |
            // | EXTPWR | RGB_HUD | RGB_HUI | RGB_SAD | RGB_SAI | RGB_EFF |                  |      |      |       |      |       |       |
            // |        | RGB_BRD | RGB_BRI |         |         |         |                  |      |      |       |      |       |       |
            // |        |         |         |         |         |         | RGB_TOG | |      |      |      |       |      |       |       |
            //                    |         |         |         |         |         | |      |      |      |       |      |

            bindings = <
&trans &trans &trans &trans &trans &trans               &trans &trans &trans &trans &trans &trans
&trans &trans &trans &trans &trans &trans               &trans &trans &trans &trans &trans &trans
&trans &trans &trans &trans &trans &trans               &trans &trans &trans &trans &trans &trans
&trans &trans &trans &trans &trans &trans               &trans &trans &trans &trans &trans &trans
&trans        &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans

&trans &trans &trans &trans &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };
    };
};
